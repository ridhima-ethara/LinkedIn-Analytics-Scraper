# Copy to .env  (never commit .env)
#
# Fernet key used to encrypt the persisted Playwright storage state.
# Generate with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If unset, the tool creates secrets/session.key (chmod 600) automatically.
LI_SESSION_KEY=

# OPTIONAL — headless-server bootstrap path only (see EC2_SETUP.md).
# Value of the li_at cookie from a browser where YOU logged in manually.
# Used by:  python login.py --from-cookie-env
LI_AT=
LI_JSESSIONID=

# Optional overrides for config.yaml
LIA_COMPANY_URL=
LIA_HEADLESS=
LIA_DATE_RANGE=
LIA_MAX_POSTS=
